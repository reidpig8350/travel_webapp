# Google Sheets 雲端資料庫設定
# 1. 建立一個 Google 試算表，可直接貼上「完整 Google Sheet 網址」或「SPREADSHEET_ID」
#    範例網址: https://docs.google.com/spreadsheets/d/1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms/edit
GOOGLE_SPREADSHEET_ID=1i7igBbEvVQ3dG6DsR8-ZjujqQMJDjDt0OlWN_1KgOHA

# 2. GCP IAM Service Account 金鑰（可放檔案路徑、完整 JSON 字串或 Base64 字串）
#    記得將此 Service Account 的 email (xxx@xxx.iam.gserviceaccount.com) 加入試算表的「編輯者」權限！
GOOGLE_SERVICE_ACCOUNT_KEY=./gcp_service_account_key.json

# 3. 預設載入的旅行分頁名稱（不同分頁代表不同旅行，每趟旅行會自動配對 <名稱> 與 <名稱>_Expenses 分頁）
GOOGLE_SHEET_DEFAULT_TRIP=歐洲行_2026

# 伺服器連接埠 (GCP Cloud Run 預設會自動注入 PORT=8080)
PORT=3000

# 3. CARTO Basemaps API Key（用於移除 Leaflet 底圖浮水印，免費申請: https://carto.com/basemaps/apikey）
NEXT_PUBLIC_CARTO_API_KEY=your_carto_api_key_here

# 4. Google Gemini 即時翻譯設定 (購物模式)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite

# 即時翻譯可選語系清單 (格式: code:名稱,code:名稱)
NEXT_PUBLIC_TRANSLATE_SOURCE_LANGS="zh-TW:繁體中文,en:English"
NEXT_PUBLIC_TRANSLATE_TARGET_LANGS="it:義大利文 (Italiano),de:德文 (Deutsch),fr:法文 (Français),en:English (英文)"

# 購物即時翻譯常用片語清單 (以逗號分隔，可依需求隨意編輯增減)
NEXT_PUBLIC_TRANSLATE_QUICK_PHRASES="請問可以退稅嗎？,可以刷 Apple Pay 嗎？,有新的或別的尺寸嗎？,請給我明細收據，謝謝！,請問這件多少錢？,我可以試穿這個嗎？"
